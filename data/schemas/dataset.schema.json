{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z]{2,5}-\\d{2,3}$|^[A-Z]{2,5}-[A-Z]{2,5}$",
          "title": "Code",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/AssetCategory"
        },
        "geometry": {
          "discriminator": {
            "mapping": {
              "LineString": "#/$defs/LineStringGeometry",
              "Point": "#/$defs/PointGeometry",
              "Polygon": "#/$defs/PolygonGeometry"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PointGeometry"
            },
            {
              "$ref": "#/$defs/LineStringGeometry"
            },
            {
              "$ref": "#/$defs/PolygonGeometry"
            }
          ],
          "title": "Geometry"
        },
        "elevation_m": {
          "anyOf": [
            {
              "maximum": 9000,
              "minimum": -100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation M"
        },
        "physical_condition": {
          "$ref": "#/$defs/PhysicalCondition",
          "default": "INTACT"
        },
        "criticality": {
          "maximum": 100,
          "minimum": 0,
          "title": "Criticality",
          "type": "integer"
        },
        "capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "capacity_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Unit"
        },
        "utilization": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utilization"
        },
        "population_served": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Served"
        },
        "is_source": {
          "default": false,
          "title": "Is Source",
          "type": "boolean"
        },
        "backup_power_hours": {
          "anyOf": [
            {
              "maximum": 720,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backup Power Hours"
        },
        "recovery_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "code",
        "name",
        "category",
        "geometry",
        "criticality"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetCategory": {
      "enum": [
        "GRID_SUPPLY",
        "POWER_GENERATION",
        "SUBSTATION",
        "POWER_DISTRIBUTION",
        "HOSPITAL",
        "TELECOM_HUB",
        "TELECOM_TOWER",
        "DATA_CENTER",
        "EMERGENCY_OPS_CENTER",
        "FIRE_STATION",
        "WATER_INTAKE",
        "WATER_TREATMENT",
        "WATER_PUMPING",
        "FUEL_DEPOT",
        "ROAD_SEGMENT",
        "BRIDGE",
        "DEMAND_ZONE"
      ],
      "title": "AssetCategory",
      "type": "string"
    },
    "DatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9-]+$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds",
          "type": "array"
        },
        "center": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version",
        "synthetic",
        "description",
        "bounds",
        "center"
      ],
      "title": "DatasetManifest",
      "type": "object"
    },
    "DependencyGroupRecord": {
      "additionalProperties": false,
      "description": "One requirement group of one dependent: needs `min_required` of `providers`.",
      "properties": {
        "group": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,40}$",
          "title": "Group",
          "type": "string"
        },
        "service_type": {
          "$ref": "#/$defs/ServiceType"
        },
        "mode": {
          "$ref": "#/$defs/DependencyMode"
        },
        "min_required": {
          "default": 1,
          "minimum": 1,
          "title": "Min Required",
          "type": "integer"
        },
        "providers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Providers",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "group",
        "service_type",
        "mode",
        "providers",
        "description"
      ],
      "title": "DependencyGroupRecord",
      "type": "object"
    },
    "DependencyMode": {
      "enum": [
        "HARD",
        "SOFT"
      ],
      "title": "DependencyMode",
      "type": "string"
    },
    "DependentRecord": {
      "additionalProperties": false,
      "properties": {
        "dependent": {
          "pattern": "^[A-Z]{2,5}-\\d{2,3}$|^[A-Z]{2,5}-[A-Z]{2,5}$",
          "title": "Dependent",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/DependencyGroupRecord"
          },
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "dependent",
        "requirements"
      ],
      "title": "DependentRecord",
      "type": "object"
    },
    "LineStringGeometry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "LineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              },
              {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "LineStringGeometry",
      "type": "object"
    },
    "PhysicalCondition": {
      "enum": [
        "INTACT",
        "DEGRADED",
        "DAMAGED",
        "DESTROYED"
      ],
      "title": "PhysicalCondition",
      "type": "string"
    },
    "PointGeometry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PointGeometry",
      "type": "object"
    },
    "PolygonGeometry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number"
                },
                {
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PolygonGeometry",
      "type": "object"
    },
    "RecoveryProfile": {
      "additionalProperties": false,
      "description": "What it takes to repair/replace the asset (used from Phase 4).",
      "properties": {
        "trade": {
          "$ref": "#/$defs/Trade"
        },
        "crew_size": {
          "maximum": 20,
          "minimum": 1,
          "title": "Crew Size",
          "type": "integer"
        },
        "repair_minutes": {
          "exclusiveMinimum": 0,
          "title": "Repair Minutes",
          "type": "integer"
        },
        "replace_minutes": {
          "exclusiveMinimum": 0,
          "title": "Replace Minutes",
          "type": "integer"
        },
        "parts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "consumed by a repair",
          "title": "Parts",
          "type": "object"
        },
        "replace_parts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "consumed by a full replacement",
          "title": "Replace Parts",
          "type": "object"
        },
        "cost": {
          "description": "repair cost, synthetic currency units",
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        }
      },
      "required": [
        "trade",
        "crew_size",
        "repair_minutes",
        "replace_minutes",
        "cost"
      ],
      "title": "RecoveryProfile",
      "type": "object"
    },
    "ServiceType": {
      "enum": [
        "POWER",
        "TELECOM",
        "WATER",
        "FUEL",
        "DATA",
        "HEALTHCARE",
        "ACCESS"
      ],
      "title": "ServiceType",
      "type": "string"
    },
    "Trade": {
      "enum": [
        "ELECTRICAL",
        "TELECOM",
        "WATER",
        "CIVIL",
        "MECHANICAL"
      ],
      "title": "Trade",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The parsed content of a dataset directory.",
  "properties": {
    "manifest": {
      "$ref": "#/$defs/DatasetManifest"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    },
    "dependents": {
      "items": {
        "$ref": "#/$defs/DependentRecord"
      },
      "title": "Dependents",
      "type": "array"
    }
  },
  "required": [
    "manifest",
    "assets",
    "dependents"
  ],
  "title": "DatasetFiles",
  "type": "object"
}
