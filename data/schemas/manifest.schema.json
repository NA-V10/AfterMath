{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "pattern": "^[a-z0-9-]+$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "bounds": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Bounds",
      "type": "array"
    },
    "center": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Center",
      "type": "array"
    }
  },
  "required": [
    "name",
    "version",
    "synthetic",
    "description",
    "bounds",
    "center"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
