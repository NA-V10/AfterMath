# AFTERMATH environment configuration — copy to .env and adjust.
# SIMULATION ENVIRONMENT — NOT CONNECTED TO LIVE INFRASTRUCTURE.

AFTERMATH_ENV=development            # development | test | production

# PostgreSQL
POSTGRES_DB=aftermath
POSTGRES_USER=aftermath
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://aftermath:change-me-local-only@localhost:5432/aftermath

# API
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Auth (Phase 5) — must be overridden outside development
JWT_SECRET=dev-only-insecure-secret
GOVERNANCE_SEPARATION_OF_DUTIES=true

# LLM (Phase 3). "deterministic" runs fully offline with no API key.
LLM_PROVIDER=deterministic           # deterministic | anthropic | openai_compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_FALLBACK_PROVIDER=deterministic

# Frontend
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
